{
  "name": "sentry-signal-cockpit",
  "private": true,
  "version": "0.1.0",
  "description": "Demo-only headless 360 signal cockpit for Sentry — fully self-contained prototype with synthetic data. Not connected to Salesforce, Data 360, Slack, or any live system.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node data/generate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
