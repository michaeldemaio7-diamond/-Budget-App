DATABASE_URL="file:./dev.db"

# App URL (update to your domain in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth for Gmail integration
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add "$NEXT_PUBLIC_APP_URL/api/gmail/callback" as an Authorized Redirect URI
# 4. Enable the Gmail API in APIs & Services → Library
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# SMTP for budget alert emails (use a Gmail App Password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_USER="michaeldemaio7@gmail.com"
SMTP_PASS=""
